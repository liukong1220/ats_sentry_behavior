<?xml version="1.0" encoding="UTF-8"?>
<!-- P6 二：官方 RMUL 树的统一导航执行接口是
     `ats_navigation_interfaces/action/NavigateToPose` on `/ats_navigate_to_pose`。
     终端成功只认 `RESULT_SUCCEEDED`；禁止 `PublishTwist` 直发底盘。 -->
<root BTCPP_format="4">
  <BehaviorTree ID="vision_override_realtime">
    <Sequence>
      <IsRobotResourceMode state="engage"
                           robot_status="{@referee_robotStatus}"/>
      <IsVisionTargetValid key_port="{@sp_vision_target}"
                           timeout_s="{@decision_vision_timeout_s}"
                           require_nav_hold="true"
                           gimbal_yaw="{vision_gimbal_yaw}"
                           gimbal_pitch="{vision_gimbal_pitch}"
                           target_id="{vision_target_id}"/>
      <PublishRobotMode mode="attack"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
      <PublishGimbalAbsolute topic_name="{@decision_gimbal_topic}"
                             duration="0.0"
                             gimbal_yaw="{vision_gimbal_yaw}"
                             gimbal_pitch="{vision_gimbal_pitch}"/>
      <SelectVisionFollowPath key_port="{@sp_vision_target}"
                              current_pose="{@decision_current_pose}"
                              current_costmap="{@nav_globalCostmap}"
                              path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="check_game_start">
    <Fallback>
      <IsGameStatus name="IsGameStart"
                    max_remain_time="{@decision_game_start_max_remain_time}"
                    min_remain_time="{@decision_game_start_min_remain_time}"
                    expected_game_progress="{@decision_game_start_expected_progress}"
                    key_port="{@referee_gameStatus}"/>
      <ForceFailure>
        <Sequence>
          <PublishRobotMode mode="move"
                            duration="0.0"
                            topic_name="{@decision_robot_mode_topic}"/>
          <PublishSpinSpeed spin_speed="0.0"
                            duration="0.0"
                            topic_name="{@decision_spin_topic}"/>
          <!-- 开局未到时的停车由授权链负责（同 `rmuc_2026_mapping.xml`）：
               子树 FAILURE -> 主树 halt 导航分支 -> `SendAtsNavGoal` cancel ->
               目标管理器 `ExecutionCommand STOP` -> 串口零速度。 -->
        </Sequence>
      </ForceFailure>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="decision_safe_point">
    <Sequence>
      <PublishRobotMode mode="defend"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
      <ResetLowHpTarget selected_index="{@decision_low_hp_target_index}"/>
      <SelectFixedPath target_index="{@decision_supply_safe_point_index}"
                       path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="decision_retreat">
    <Sequence>
      <PublishRobotMode mode="defend"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
      <SelectNearestRetreatPath current_pose="{@decision_current_pose}"
                                selected_index="{@decision_low_hp_target_index}"
                                path="{decision_path}"/>
      <!-- 到点后清退避目标：只能在 ATS action 给出 `RESULT_SUCCEEDED` 之后。 -->
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
      <ResetLowHpTarget selected_index="{@decision_low_hp_target_index}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="decision_critical_time_target">
    <Sequence>
      <PublishRobotMode mode="move"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
      <ResetLowHpTarget selected_index="{@decision_low_hp_target_index}"/>
      <SelectFixedPath target_index="{@decision_critical_time_target_index}"
                       path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="decision_anchor_target">
    <Sequence>
      <PublishRobotMode mode="move"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
      <ResetLowHpTarget selected_index="{@decision_low_hp_target_index}"/>
      <SelectFixedPath target_index="{@decision_anchor_target_index}"
                       path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="decision_patrol">
    <Sequence>
      <PublishRobotMode mode="move"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
      <ResetLowHpTarget selected_index="{@decision_low_hp_target_index}"/>
      <SelectPatrolPath patrol_cursor="{decision_patrol_cursor}"
                        patrol_direction="{decision_patrol_direction}"
                        path="{decision_path}"
                        next_cursor="{decision_next_patrol_cursor}"
                        next_direction="{decision_next_patrol_direction}"/>
      <!-- 巡逻游标推进只能由 ATS action 的终端成功驱动。 -->
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
      <AdvancePatrolCursor next_cursor="{decision_next_patrol_cursor}"
                           next_direction="{decision_next_patrol_direction}"
                           patrol_cursor="{decision_patrol_cursor}"
                           patrol_direction="{decision_patrol_direction}"
                           goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="decision_simulation">
    <ReactiveFallback>
      <Sequence>
        <IsRobotHpBelow robot_status="{@referee_robotStatus}"
                        threshold="{@decision_resupply_enter_hp}"/>
        <SubTree ID="decision_safe_point"/>
      </Sequence>

      <Sequence>
        <IsRobotResourceMode state="resupply"
                             robot_status="{@referee_robotStatus}"/>
        <SubTree ID="decision_safe_point"/>
      </Sequence>

      <Sequence>
        <IsDecisionMode mode="safe"/>
        <SubTree ID="decision_safe_point"/>
      </Sequence>

      <Sequence>
        <IsDecisionMode mode="retreat"/>
        <SubTree ID="decision_retreat"/>
      </Sequence>

      <Sequence>
        <IsDecisionMode mode="anchor"/>
        <SubTree ID="decision_anchor_target"/>
      </Sequence>

      <Sequence>
        <IsDecisionMode mode="patrol"/>
        <SubTree ID="decision_patrol"/>
      </Sequence>

      <SubTree ID="decision_patrol"/>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="decision_referee">
    <ReactiveSequence>
      <ReactiveFallback>
        <Sequence>
          <IsRobotHpBelow robot_status="{@referee_robotStatus}"
                          threshold="{@decision_resupply_enter_hp}"/>
          <SubTree ID="decision_safe_point"/>
        </Sequence>

        <Sequence>
          <IsRobotResourceMode state="resupply"
                               robot_status="{@referee_robotStatus}"/>
          <SubTree ID="decision_safe_point"/>
        </Sequence>

        <Sequence>
          <IsRobotResourceMode state="engage"
                               robot_status="{@referee_robotStatus}"/>
          <IsGameTimeStage stage="critical"/>
          <SubTree ID="decision_critical_time_target"/>
        </Sequence>

        <Sequence>
          <IsRobotResourceMode state="engage"
                               robot_status="{@referee_robotStatus}"/>
          <SubTree ID="decision_patrol"/>
        </Sequence>

        <Sequence>
          <SubTree ID="decision_patrol"/>
        </Sequence>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="rmul_2026">
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <ReactiveSequence>
          <SubTree ID="check_game_start"/>
          <ReactiveFallback>
            <Sequence>
              <IsAttacked key_port="{@referee_robotStatus}"/>
              <PublishSpinSpeed spin_speed="{@decision_default_spin_speed}"
                                duration="0.0"
                                topic_name="{@decision_spin_topic}"/>
            </Sequence>
            <PublishSpinSpeed spin_speed="0.0"
                              duration="0.0"
                              topic_name="{@decision_spin_topic}"/>
          </ReactiveFallback>
        <ReactiveFallback>
            <SubTree ID="vision_override_realtime"/>

            <Sequence>
              <IsDecisionInputSource source="simulation"/>
              <SubTree ID="decision_simulation"/>
            </Sequence>

            <Sequence>
              <IsDecisionInputSource source="referee"/>
              <SubTree ID="decision_referee"/>
            </Sequence>
          </ReactiveFallback>
        </ReactiveSequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
