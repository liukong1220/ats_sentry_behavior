<?xml version="1.0" encoding="UTF-8"?>
<!-- P6 二：官方 RMUC 树的统一导航执行接口是
     `ats_navigation_interfaces/action/NavigateToPose` on `/ats_navigate_to_pose`
     （服务端 `ats_goal_manager_node`）。约束：
     1. 终端成功只能来自 action 的 `RESULT_SUCCEEDED`，不得用 `IsPathGoalReached`
        的位置容差替代；「已到达就不重发」的记忆放在 `SendAtsNavGoal` 的航点状态机里。
     2. 官方树禁止 `PublishTwist`：行为层不得绕过 `/planner/execution_command`
        直发 Twist 到底盘。
     3. 行为层只经 `SendAtsNavGoal` 进入目标管理器。 -->
<root BTCPP_format="4">
  <BehaviorTree ID="rmuc_vision_override_realtime">
    <Sequence>
      <IsRobotResourceMode state="engage"
                           robot_status="{@referee_robotStatus}"/>
      <IsVisionTargetValid key_port="{@sp_vision_target}"
                           timeout_s="{@decision_vision_timeout_s}"
                           require_nav_hold="true"
                           gimbal_yaw="{vision_gimbal_yaw}"
                           gimbal_pitch="{vision_gimbal_pitch}"
                           target_id="{vision_target_id}"/>
      <PublishRobotMode mode="attack"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
      <PublishGimbalAbsolute topic_name="{@decision_gimbal_topic}"
                             duration="0.0"
                             gimbal_yaw="{vision_gimbal_yaw}"
                             gimbal_pitch="{vision_gimbal_pitch}"/>
      <SelectVisionFollowPath key_port="{@sp_vision_target}"
                              current_pose="{@decision_current_pose}"
                              current_costmap="{@nav_globalCostmap}"
                              path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_check_game_start">
    <Fallback>
      <IsGameStatus name="IsGameStart"
                    max_remain_time="{@decision_game_start_max_remain_time}"
                    min_remain_time="{@decision_game_start_min_remain_time}"
                    expected_game_progress="{@decision_game_start_expected_progress}"
                    key_port="{@referee_gameStatus}"/>
      <ForceFailure>
        <Sequence>
          <PublishRobotMode mode="move"
                            duration="0.0"
                            topic_name="{@decision_robot_mode_topic}"/>
          <PublishSpinSpeed spin_speed="0.0"
                            duration="0.0"
                            topic_name="{@decision_spin_topic}"/>
          <!-- 开局未到时的停车由授权链负责：本子树返回 FAILURE 会让主树的
               ReactiveSequence 直接 halt 后面的导航分支，`SendAtsNavGoal` 在
               halt 中 cancel 目标，目标管理器随即发 `ExecutionCommand STOP`，
               经 `emergency_stop=true -> /cmd_vel_mpc=0 -> /motion_control=0`
               到串口零速度。行为层不得再直发 Twist 绕过这条链。 -->
        </Sequence>
      </ForceFailure>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_decision_supply">
    <Sequence>
      <SelectSupplyPoint path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_decision_defend_hold">
    <PublishRobotMode mode="defend"
                      duration="0.0"
                      topic_name="{@decision_robot_mode_topic}"/>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_decision_mapping_route">
    <Sequence>
      <LoadCsvWaypoints csv_file="{@decision_rmuc_csv_file}"
                        patrol_mode="false"
                        path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_decision_patrol">
    <Sequence>
      <LoadCsvWaypoints csv_file="{@decision_rmuc_patrol_csv_file}"
                        patrol_mode="true"
                        patrol_cursor="{decision_patrol_cursor}"
                        patrol_direction="{decision_patrol_direction}"
                        path="{decision_path}"
                        next_cursor="{decision_next_patrol_cursor}"
                        next_direction="{decision_next_patrol_direction}"/>
      <!-- 巡逻游标推进只能由 ATS action 的终端成功驱动：
           `SendAtsNavGoal` 返回 SUCCESS 表示当前航点拿到了 `RESULT_SUCCEEDED`，
           之后 `AdvancePatrolCursor` 才推进 cursor 并把 goal_succeeded 复位。 -->
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
      <AdvancePatrolCursor next_cursor="{decision_next_patrol_cursor}"
                           next_direction="{decision_next_patrol_direction}"
                           patrol_cursor="{decision_patrol_cursor}"
                           patrol_direction="{decision_patrol_direction}"
                           goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_publish_navigation_mode">
    <ReactiveFallback>
      <Sequence>
        <IsRobotResourceMode state="defend"
                             robot_status="{@referee_robotStatus}"/>
        <SubTree ID="rmuc_decision_defend_hold"/>
      </Sequence>
      <PublishRobotMode mode="move"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_decision_referee_mapping">
    <ReactiveSequence>
      <ReactiveFallback>
        <Sequence>
          <IsRobotResupplyRequired robot_status="{@referee_robotStatus}"/>
          <SubTree ID="rmuc_decision_supply"/>
        </Sequence>

        <Sequence>
          <Fallback>
            <IsGameStatus name="IsMappingEndgame"
                          max_remain_time="{@decision_rmuc_endgame_time_threshold}"
                          min_remain_time="0"
                          expected_game_progress="{@decision_game_start_expected_progress}"
                          key_port="{@referee_gameStatus}"/>
            <IsFriendlyOutpostDestroyed all_robot_hp="{@referee_allRobotHP}"
                                        robot_status="{@referee_robotStatus}"/>
          </Fallback>
          <SubTree ID="rmuc_decision_patrol"/>
        </Sequence>

        <SubTree ID="rmuc_decision_mapping_route"/>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_2026_mapping">
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <ReactiveSequence>
          <SubTree ID="rmuc_check_game_start"/>
          <ReactiveFallback>
            <Sequence>
              <IsAttacked key_port="{@referee_robotStatus}"/>
              <PublishSpinSpeed spin_speed="{@decision_hit_spin_speed}"
                                duration="0.0"
                                topic_name="{@decision_spin_topic}"/>
            </Sequence>
            <PublishSpinSpeed spin_speed="{@decision_default_spin_speed}"
                              duration="0.0"
                              topic_name="{@decision_spin_topic}"/>
          </ReactiveFallback>
          <Sequence>
            <IsDecisionInputSource source="referee"/>
            <SubTree ID="rmuc_publish_navigation_mode"/>
          </Sequence>
          <ReactiveFallback>
            <SubTree ID="rmuc_vision_override_realtime"/>

            <Sequence>
              <IsDecisionInputSource source="referee"/>
              <SubTree ID="rmuc_decision_referee_mapping"/>
            </Sequence>
          </ReactiveFallback>
        </ReactiveSequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
