<?xml version="1.0" encoding="UTF-8"?>
<!-- P6 二：官方 RMUC 备用树同样使用
     `ats_navigation_interfaces/action/NavigateToPose` on `/ats_navigate_to_pose`。
     终端成功只认 `RESULT_SUCCEEDED`；禁止 `PublishTwist` 直发底盘。 -->
<root BTCPP_format="4">
  <BehaviorTree ID="rmuc_patrol_only_vision_override_realtime">
    <Sequence>
      <IsRobotResourceMode state="engage"
                           robot_status="{@referee_robotStatus}"/>
      <IsVisionTargetValid key_port="{@sp_vision_target}"
                           timeout_s="{@decision_vision_timeout_s}"
                           require_nav_hold="true"
                           gimbal_yaw="{vision_gimbal_yaw}"
                           gimbal_pitch="{vision_gimbal_pitch}"
                           target_id="{vision_target_id}"/>
      <PublishRobotMode mode="attack"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
      <PublishGimbalAbsolute topic_name="{@decision_gimbal_topic}"
                             duration="0.0"
                             gimbal_yaw="{vision_gimbal_yaw}"
                             gimbal_pitch="{vision_gimbal_pitch}"/>
      <SelectVisionFollowPath key_port="{@sp_vision_target}"
                              current_pose="{@decision_current_pose}"
                              current_costmap="{@nav_globalCostmap}"
                              path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_patrol_only_vision_override_no_referee">
    <Sequence>
      <IsVisionTargetValid key_port="{@sp_vision_target}"
                           timeout_s="{@decision_vision_timeout_s}"
                           require_nav_hold="true"
                           gimbal_yaw="{vision_gimbal_yaw}"
                           gimbal_pitch="{vision_gimbal_pitch}"
                           target_id="{vision_target_id}"/>
      <PublishRobotMode mode="attack"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
      <PublishGimbalAbsolute topic_name="{@decision_gimbal_topic}"
                             duration="0.0"
                             gimbal_yaw="{vision_gimbal_yaw}"
                             gimbal_pitch="{vision_gimbal_pitch}"/>
      <SelectVisionFollowPath key_port="{@sp_vision_target}"
                              current_pose="{@decision_current_pose}"
                              current_costmap="{@nav_globalCostmap}"
                              path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_patrol_only_check_game_start">
    <Fallback>
      <IsGameStatus name="IsGameStart"
                    max_remain_time="{@decision_game_start_max_remain_time}"
                    min_remain_time="{@decision_game_start_min_remain_time}"
                    expected_game_progress="{@decision_game_start_expected_progress}"
                    key_port="{@referee_gameStatus}"/>
      <ForceFailure>
        <Sequence>
          <PublishRobotMode mode="move"
                            duration="0.0"
                            topic_name="{@decision_robot_mode_topic}"/>
          <PublishSpinSpeed spin_speed="0.0"
                            duration="0.0"
                            topic_name="{@decision_spin_topic}"/>
          <!-- 开局未到时的停车由授权链负责（同 `rmuc_2026_mapping.xml`）：
               子树 FAILURE -> 主树 halt 导航分支 -> `SendAtsNavGoal` cancel ->
               目标管理器 `ExecutionCommand STOP` -> 串口零速度。 -->
        </Sequence>
      </ForceFailure>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_patrol_only_decision_supply">
    <Sequence>
      <SelectSupplyPoint path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_patrol_only_decision_defend_hold">
    <PublishRobotMode mode="defend"
                      duration="0.0"
                      topic_name="{@decision_robot_mode_topic}"/>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_patrol_only_decision_patrol">
    <Sequence>
      <LoadCsvWaypoints csv_file="{@decision_rmuc_patrol_csv_file}"
                        patrol_mode="false"
                        path="{decision_path}"/>
      <SendAtsNavGoal path="{decision_path}"
                      goal_succeeded="{decision_nav_goal_succeeded}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_patrol_only_publish_navigation_mode">
    <ReactiveFallback>
      <Sequence>
        <IsRobotResourceMode state="defend"
                             robot_status="{@referee_robotStatus}"/>
        <SubTree ID="rmuc_patrol_only_decision_defend_hold"/>
      </Sequence>
      <PublishRobotMode mode="move"
                        duration="0.0"
                        topic_name="{@decision_robot_mode_topic}"/>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_patrol_only_decision_referee">
    <ReactiveSequence>
      <ReactiveFallback>
        <Sequence>
          <IsRobotResupplyRequired robot_status="{@referee_robotStatus}"/>
          <SubTree ID="rmuc_patrol_only_decision_supply"/>
        </Sequence>

        <SubTree ID="rmuc_patrol_only_decision_patrol"/>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_2026_patrol_only">
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <ReactiveSequence>
          <SubTree ID="rmuc_patrol_only_check_game_start"/>
          <ReactiveFallback>
            <Sequence>
              <IsAttacked key_port="{@referee_robotStatus}"/>
              <PublishSpinSpeed spin_speed="{@decision_hit_spin_speed}"
                                duration="0.0"
                                topic_name="{@decision_spin_topic}"/>
            </Sequence>
            <PublishSpinSpeed spin_speed="{@decision_default_spin_speed}"
                              duration="0.0"
                              topic_name="{@decision_spin_topic}"/>
          </ReactiveFallback>
          <Sequence>
            <IsDecisionInputSource source="referee"/>
            <SubTree ID="rmuc_patrol_only_publish_navigation_mode"/>
          </Sequence>
          <ReactiveFallback>
            <SubTree ID="rmuc_patrol_only_vision_override_realtime"/>

            <Sequence>
              <IsDecisionInputSource source="referee"/>
              <SubTree ID="rmuc_patrol_only_decision_referee"/>
            </Sequence>
          </ReactiveFallback>
        </ReactiveSequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <BehaviorTree ID="rmuc_2026_patrol_only_no_referee_vision_test">
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <ReactiveSequence>
          <PublishSpinSpeed spin_speed="{@decision_default_spin_speed}"
                            duration="0.0"
                            topic_name="{@decision_spin_topic}"/>
          <ReactiveFallback>
            <SubTree ID="rmuc_patrol_only_vision_override_no_referee"/>
            <SubTree ID="rmuc_patrol_only_decision_patrol"/>
          </ReactiveFallback>
        </ReactiveSequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
