# Standalone source dependency manifest for ats_sentry_behavior.
#
# Import from an ATS workspace root after cloning this repository to
# src/ats_sentry_behavior:
#   vcs import --skip-existing src < src/ats_sentry_behavior/dependencies.repos
#
# ROS distribution packages remain rosdep-owned. These repositories provide
# BehaviorTree.ROS2 plus ATS interfaces that are not available from rosdep.
repositories:
  dependencies/BehaviorTree.ROS2:
    type: git
    url: git@github.com:liukong1220/BehaviorTree.ROS2.git
    version: humble

  interfaces:
    type: git
    url: git@github.com:liukong1220/interfaces.git
    version: develop

  ats_sentry_nav:
    type: git
    url: git@github.com:liukong1220/ats_sentry_nav.git
    version: develop
